# OpenRouter (LLM) configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Cohere (embeddings + rerank)
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_EMBED_MODEL=embed-v4.0
COHERE_RERANK_MODEL=rerank-v4.0-pro
COHERE_EMBED_INPUT_TYPE_DOC=search_document
COHERE_EMBED_INPUT_TYPE_QUERY=search_query

# Neo4j (Local by default)
# Start a local Neo4j using:
#   docker compose -f docker-compose.neo4j.yml up -d
# Aura example (cloud):
#   NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=jitmind_local_password
NEO4J_DATABASE=neo4j

# Optional: Graph ontology constraints (comma-separated)
# Example:
#   GRAPH_ENTITY_TYPES=Person,Org,Location,Concept
#   GRAPH_RELATION_TYPES=WORKS_AT,LOCATED_IN,RELATED_TO
GRAPH_ENTITY_TYPES=
GRAPH_RELATION_TYPES=
GRAPH_ALLOW_UNKNOWN=true
